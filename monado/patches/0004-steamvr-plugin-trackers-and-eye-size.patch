+/*
+ *
+ * ikharness: generic trackers. Upstream forwards only the HMD and the two hand controllers;
+ * full body tracking in SteamVR applications needs the trackers as well.
+ *
+ */
+
+static const char *
+ikh_tracker_role_of(const struct xrt_device *xdev)
+{
+	// Longest names first so that "left_foot" is not taken for a shorter role.
+	static const char *roles[] = {"left_shoulder", "right_shoulder", "left_elbow", "right_elbow", "left_knee",
+	                              "right_knee",    "left_foot",      "right_foot", "waist",       "chest",
+	                              "camera",        "keyboard"};
+	for (size_t i = 0; i < ARRAY_SIZE(roles); i++) {
+		if (strstr(xdev->serial, roles[i]) != NULL || strstr(xdev->str, roles[i]) != NULL) {
+			return roles[i];
+		}
+	}
+	return NULL;
+}
+
+class CDeviceDriver_Monado_Tracker : public vr::ITrackedDeviceServerDriver
+{
+public:
+	CDeviceDriver_Monado_Tracker(struct xrt_device *xdev) : m_xdev(xdev)
+	{
+		m_unObjectId = vr::k_unTrackedDeviceIndexInvalid;
+		m_ulPropertyContainer = vr::k_ulInvalidPropertyContainer;
+		m_pose = {};
+		m_role = ikh_tracker_role_of(xdev);
+
+		snprintf(m_sModelNumber, MODELNUM_LEN, "[Monado] %s", xdev->str);
+		snprintf(m_sSerialNumber, XRT_DEVICE_NAME_LEN, "%s", xdev->serial);
+
+		// Which pose input to read: the generic tracker pose, else the first input.
+		m_pose_name = xdev->input_count > 0 ? xdev->inputs[0].name : XRT_INPUT_GENERIC_TRACKER_POSE;
+		for (size_t i = 0; i < xdev->input_count; i++) {
+			if (xdev->inputs[i].name == XRT_INPUT_GENERIC_TRACKER_POSE) {
+				m_pose_name = XRT_INPUT_GENERIC_TRACKER_POSE;
+			}
+		}
+
+		ovrd_log("Creating Tracker %s (role %s)\n", xdev->str, m_role != NULL ? m_role : "none");
+		vr::VRServerDriverHost()->TrackedDeviceAdded(m_sSerialNumber, vr::TrackedDeviceClass_GenericTracker, this);
+	}
+	virtual ~CDeviceDriver_Monado_Tracker() {}
+
+	vr::EVRInitError
+	Activate(vr::TrackedDeviceIndex_t unObjectId)
+	{
+		ovrd_log("Activating Tracker SteamVR[%d]\n", unObjectId);
+		if (m_xdev == NULL) {
+			return vr::VRInitError_Init_InterfaceNotFound;
+		}
+
+		m_unObjectId = unObjectId;
+		m_ulPropertyContainer = vr::VRProperties()->TrackedDeviceToPropertyContainer(m_unObjectId);
+
+		// clang-format off
+		vr::VRProperties()->SetInt32Property(m_ulPropertyContainer, vr::Prop_DeviceClass_Int32, vr::TrackedDeviceClass_GenericTracker);
+		vr::VRProperties()->SetStringProperty(m_ulPropertyContainer, vr::Prop_ModelNumber_String, m_sModelNumber);
+		vr::VRProperties()->SetStringProperty(m_ulPropertyContainer, vr::Prop_SerialNumber_String, m_sSerialNumber);
+		vr::VRProperties()->SetStringProperty(m_ulPropertyContainer, vr::Prop_ManufacturerName_String, "Monado");
+		vr::VRProperties()->SetStringProperty(m_ulPropertyContainer, vr::Prop_RenderModelName_String, "{htc}vr_tracker_vive_1_0");
+		vr::VRProperties()->SetBoolProperty(m_ulPropertyContainer, vr::Prop_WillDriftInYaw_Bool, false);
+		vr::VRProperties()->SetBoolProperty(m_ulPropertyContainer, vr::Prop_NeverTracked_Bool, false);
+		// clang-format on
+
+		// The role, the two ways SteamVR and applications look for it: the controller type
+		// ("vive_tracker_waist") and the "trackers" section of the SteamVR settings.
+		char type[64];
+		if (m_role != NULL) {
+			snprintf(type, sizeof(type), "vive_tracker_%s", m_role);
+		} else {
+			snprintf(type, sizeof(type), "vive_tracker");
+		}
+		vr::VRProperties()->SetStringProperty(m_ulPropertyContainer, vr::Prop_ControllerType_String, type);
+		if (m_role != NULL) {
+			// TrackerRole_LeftFoot from left_foot.
+			char role[64] = "TrackerRole_";
+			size_t at = strlen(role);
+			bool upper = true;
+			for (const char *c = m_role; *c != '\0' && at + 1 < sizeof(role); c++) {
+				if (*c == '_') {
+					upper = true;
+					continue;
+				}
+				role[at++] = upper ? (char)toupper((unsigned char)*c) : *c;
+				upper = false;
+			}
+			role[at] = '\0';
+
+			char key[XRT_DEVICE_NAME_LEN + 32];
+			snprintf(key, sizeof(key), "/devices/monado/%s", m_sSerialNumber);
+			vr::EVRSettingsError err = vr::VRSettingsError_None;
+			vr::VRSettings()->SetString(vr::k_pch_Trackers_Section, key, role, &err);
+			if (err != vr::VRSettingsError_None) {
+				ovrd_log("Could not store role %s for %s: %d\n", role, key, (int)err);
+			}
+		}
+
+		return vr::VRInitError_None;
+	}
+
+	void
+	Deactivate()
+	{
+		m_unObjectId = vr::k_unTrackedDeviceIndexInvalid;
+	}
+
+	void
+	EnterStandby()
+	{}
+
+	void *
+	GetComponent(const char *pchComponentNameAndVersion)
+	{
+		return NULL;
+	}
+
+	void
+	DebugRequest(const char *pchRequest, char *pchResponseBuffer, uint32_t unResponseBufferSize)
+	{
+		if (unResponseBufferSize >= 1) {
+			pchResponseBuffer[0] = 0;
+		}
+	}
+
+	vr::DriverPose_t
+	GetPose()
+	{
+		m_pose.poseTimeOffset = 0;
+		if (m_xdev == NULL) {
+			m_pose.poseIsValid = false;
+			m_pose.deviceIsConnected = false;
+			m_pose.result = vr::TrackingResult_Uninitialized;
+			return m_pose;
+		}
+
+		xrt_device_update_inputs(m_xdev);
+		bool connected = m_xdev->input_count == 0 || m_xdev->inputs[0].active;
+
+		timepoint_ns now_ns = os_monotonic_get_ns();
+		struct xrt_space_relation rel;
+		xrt_device_get_tracked_pose(m_xdev, m_pose_name, now_ns, &rel);
+
+		struct xrt_pose *offset = &m_xdev->tracking_origin->initial_offset;
+		struct xrt_relation_chain chain = {};
+		m_relation_chain_push_relation(&chain, &rel);
+		m_relation_chain_push_pose_if_not_identity(&chain, offset);
+		m_relation_chain_resolve(&chain, &rel);
+
+		apply_pose(&rel, &m_pose);
+
+		bool tracked = (rel.relation_flags & XRT_SPACE_RELATION_POSITION_VALID_BIT) != 0 &&
+		               (rel.relation_flags & XRT_SPACE_RELATION_ORIENTATION_VALID_BIT) != 0;
+		m_pose.deviceIsConnected = connected;
+		m_pose.poseIsValid = connected && tracked;
+		m_pose.result = m_pose.poseIsValid ? vr::TrackingResult_Running_OK : vr::TrackingResult_Running_OutOfRange;
+
+		vr::HmdQuaternion_t identityquat{1, 0, 0, 0};
+		m_pose.qWorldFromDriverRotation = identityquat;
+		m_pose.qDriverFromHeadRotation = identityquat;
+		m_pose.vecDriverFromHeadTranslation[0] = 0.f;
+		m_pose.vecDriverFromHeadTranslation[1] = 0.f;
+		m_pose.vecDriverFromHeadTranslation[2] = 0.f;
+
+		return m_pose;
+	}
+
+	void
+	RunFrame()
+	{
+		if (m_unObjectId != vr::k_unTrackedDeviceIndexInvalid) {
+			vr::VRServerDriverHost()->TrackedDevicePoseUpdated(m_unObjectId, GetPose(),
+			                                                   sizeof(vr::DriverPose_t));
+		}
+	}
+
+	struct xrt_device *m_xdev;
+
+private:
+	vr::DriverPose_t m_pose;
+	vr::TrackedDeviceIndex_t m_unObjectId;
+	vr::PropertyContainerHandle_t m_ulPropertyContainer;
+	char m_sSerialNumber[XRT_DEVICE_NAME_LEN];
+	char m_sModelNumber[MODELNUM_LEN];
+	const char *m_role = NULL;
+	enum xrt_input_name m_pose_name;
+};
