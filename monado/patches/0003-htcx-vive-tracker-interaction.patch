+/*
+ *
+ * ikharness: XR_HTCX_vive_tracker_interaction
+ *
+ */
+
+#ifdef OXR_HAVE_HTCX_vive_tracker_interaction
+
+static void
+fill_vive_tracker_paths(XrViveTrackerPathsHTCX *dst, const XrViveTrackerPathsHTCX *src)
+{
+	dst->persistentPath = src->persistentPath;
+	dst->rolePath = src->rolePath;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL
+oxr_xrEnumerateViveTrackerPathsHTCX(XrInstance instance,
+                                    uint32_t pathCapacityInput,
+                                    uint32_t *pathCountOutput,
+                                    XrViveTrackerPathsHTCX *paths)
+{
+	OXR_TRACE_MARKER();
+
+	struct oxr_instance *inst;
+	struct oxr_logger log;
+	OXR_VERIFY_INSTANCE_AND_INIT_LOG(&log, instance, inst, "xrEnumerateViveTrackerPathsHTCX");
+	OXR_VERIFY_EXTENSION(&log, inst, HTCX_vive_tracker_interaction);
+	OXR_VERIFY_ARG_NOT_NULL(&log, pathCountOutput);
+
+	struct oxr_roles roles;
+	XrResult ret = oxr_roles_init_on_stack(&log, &roles, &inst->system);
+	if (ret != XR_SUCCESS) {
+		return ret;
+	}
+
+	XrViveTrackerPathsHTCX found[32];
+	uint32_t count = 0;
+
+#define ADD_TRACKER(NAME, NAMECAPS, PATH, LOCALIZED_NAME)                                                              \
+	do {                                                                                                           \
+		struct xrt_device *xdev = GET_XDEV_BY_ROLE(&roles, NAME);                                              \
+		if (xdev == NULL || count >= ARRAY_SIZE(found)) {                                                      \
+			break;                                                                                         \
+		}                                                                                                      \
+		/* Persistent path from the serial, restricted to the characters a path may hold. */                  \
+		char persistent[XRT_DEVICE_NAME_LEN + 64];                                                             \
+		int len = snprintf(persistent, sizeof(persistent), "/devices/htc/vive_tracker_htcx/%s", xdev->serial); \
+		for (int i = (int)strlen("/devices/htc/vive_tracker_htcx/"); i < len; i++) {                           \
+			char c = persistent[i];                                                                        \
+			if (c >= 'A' && c <= 'Z') {                                                                    \
+				persistent[i] = (char)(c - 'A' + 'a');                                                 \
+			} else if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||        \
+			             c == '.')) {                                                                      \
+				persistent[i] = '_';                                                                   \
+			}                                                                                              \
+		}                                                                                                      \
+		ret = oxr_path_get_or_create(&log, inst, persistent, strlen(persistent), &found[count].persistentPath); \
+		if (ret != XR_SUCCESS) {                                                                               \
+			return ret;                                                                                    \
+		}                                                                                                      \
+		ret = oxr_path_get_or_create(&log, inst, PATH, strlen(PATH), &found[count].rolePath);                  \
+		if (ret != XR_SUCCESS) {                                                                               \
+			return ret;                                                                                    \
+		}                                                                                                      \
+		count++;                                                                                               \
+	} while (false);
+
+	OXR_FOR_EACH_HTCX_TRACKER_ROLE_DETAILED(ADD_TRACKER)
+#undef ADD_TRACKER
+
+	OXR_TWO_CALL_FILL_IN_HELPER(&log, pathCapacityInput, pathCountOutput, paths, count, fill_vive_tracker_paths, found,
+	                            XR_SUCCESS);
+}
+
+#endif // OXR_HAVE_HTCX_vive_tracker_interaction
