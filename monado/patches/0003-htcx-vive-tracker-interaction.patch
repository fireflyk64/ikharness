+/*
+ *
+ * ikharness: XR_HTCX_vive_tracker_interaction roles.
+ *
+ */
+
+static bool
+is_word_char(char c)
+{
+	return isalnum((unsigned char)c) || c == '_';
+}
+
+//! Does @p haystack contain @p word, not embedded in a longer identifier?
+static bool
+contains_word(const char *haystack, const char *word)
+{
+	const size_t len = strlen(word);
+	for (const char *at = strstr(haystack, word); at != NULL; at = strstr(at + 1, word)) {
+		const bool starts = at == haystack || !is_word_char(at[-1]);
+		const bool ends = !is_word_char(at[len]);
+		if (starts && ends) {
+			return true;
+		}
+	}
+	return false;
+}
+
+struct xrt_device *
+oxr_roles_get_htcx_tracker(const struct oxr_roles *roles, const char *role)
+{
+	struct xrt_system_devices *xsysd = roles->sys->xsysd;
+
+	for (size_t i = 0; i < xsysd->static_xdev_count; i++) {
+		struct xrt_device *xdev = xsysd->static_xdevs[i];
+		if (xdev == NULL || xdev->device_type != XRT_DEVICE_TYPE_GENERIC_TRACKER) {
+			continue;
+		}
+		if (contains_word(xdev->serial, role) || contains_word(xdev->str, role)) {
+			return xdev;
+		}
+	}
+
+	return NULL;
+}
